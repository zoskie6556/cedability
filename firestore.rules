// ===============================================================
// Assumed Data Model
// users/{uid}: private account fields, role, evaluator type/organization and profile map. Clients create
// submitter records and may update only validated profile fields; admins can
// read user records for the admin user-management workflow.
// ideas/{ideaId}: one submitted idea with ownerId, plans, timestamps and
// server-managed category, similarityCheck and automatedReview results.
// Submitters create version 1 and cannot update or delete ideas directly.
// Evaluator request-changes and owner resubmission writes are performed by
// authenticated Cloud Functions; versions are immutable to clients.
// ideas/{ideaId}/feedback/{feedbackId}: server-written evaluator note and
// one owner-authored reply. Only the owner may read or reply.
// ideas/{ideaId}/versions/{versionId}: immutable snapshots readable by owner.
// ideas/{ideaId}/evaluatorViews/{assignmentId}: sanitized idea fields, scoring
// criteria and stage data for one external evaluator assignment.
// ideas/{ideaId}/evaluations/{stageId_evaluatorUid}: validated scores and
// recommendation; submitters cannot read evaluations.
// ideas/{ideaId}/adjudications/{stageId}: adjudicator decision; Functions
// write this document atomically with the idea status transition.
// awards/{awardId}: server-written recognition, readable by its owner or when public.
// ideas/{ideaId}/questions/{questionId}: stage-scoped evaluator question and owner response.
// assignments/{ideaId_stageId_evaluatorUid}: evaluator worklist and submission state.
// stages/{stageId}, criteriaSets/{criteriaSetId}: admin-managed evaluation configuration.
// stats/{docId}: server-written aggregates. auditLogs/{logId}: server-written
// audit events. Admin SDK writes bypass these client rules.
// collaborationProfiles/{uid}: opt-in directory projection containing only
// the user's display name and profession with normalized search keys.
// collaborationPairs/{uidA~uidB}: one canonical relationship record for a
// pair, with participant UIDs, request state and timestamps only.
// users/{uid}/newsletterPreferences/current: the owner's private newsletter
// and promotions choices, consent timestamps, and record timestamps only.
// ===============================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    function isAdjudicatorOrAdmin() {
      return request.auth != null
        && request.auth.token.role in ['adjudicator', 'admin'];
    }

    function isUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['user', 'submitter'];
    }

    function isEvaluator() {
      return request.auth != null && request.auth.token.role in ['evaluator', 'adjudicator', 'admin'];
    }

    function isExternalEvaluator() {
      return request.auth != null
        && request.auth.token.role == 'evaluator'
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('evaluatorType', 'internal') == 'external';
    }

    function isInternalEvaluator() {
      return isEvaluator() && !isExternalEvaluator();
    }

    function isAssignedToIdeaStage(ideaId, stageId, evaluatorUid) {
      let assignmentPath = /databases/$(database)/documents/assignments/$(ideaId + '_' + stageId + '_' + evaluatorUid);
      return evaluatorUid is string
        && stageId is string
        && exists(assignmentPath)
        && get(assignmentPath).data.ideaId == ideaId
        && get(assignmentPath).data.stageId == stageId
        && get(assignmentPath).data.evaluatorUid == evaluatorUid;
    }

    function isAssignmentForIdea(assignmentId, ideaId, evaluatorUid) {
      let assignmentPath = /databases/$(database)/documents/assignments/$(assignmentId);
      return exists(assignmentPath)
        && get(assignmentPath).data.ideaId == ideaId
        && get(assignmentPath).data.evaluatorUid == evaluatorUid;
    }

    function isAssignmentOpen(ideaId, stageId, evaluatorUid) {
      let assignmentPath = /databases/$(database)/documents/assignments/$(ideaId + '_' + stageId + '_' + evaluatorUid);
      return isAssignedToIdeaStage(ideaId, stageId, evaluatorUid)
        && get(assignmentPath).data.status in ['pending', 'in_progress'];
    }

    function isExternalEvaluatorAccount(uid) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      return exists(userPath)
        && get(userPath).data.role == 'evaluator'
        && get(userPath).data.get('evaluatorType', 'internal') == 'external';
    }

    function isValidAssignment(data, assignmentId) {
      return data is map
        && data.keys().hasAll([
          'ideaId', 'stageId', 'evaluatorUid', 'status', 'assignedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ideaId', 'stageId', 'evaluatorUid', 'status', 'dueAt', 'assignedBy', 'createdAt', 'updatedAt'
        ])
        && data.ideaId is string && data.ideaId.size() > 0 && data.ideaId.size() <= 128
        && data.stageId is string && data.stageId.size() > 0 && data.stageId.size() <= 80
        && data.evaluatorUid is string && data.evaluatorUid.size() > 0 && data.evaluatorUid.size() <= 128
        && assignmentId == data.ideaId + '_' + data.stageId + '_' + data.evaluatorUid
        && data.status in ['pending', 'in_progress', 'done']
        && data.assignedBy is string && data.assignedBy.size() > 0 && data.assignedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('dueAt' in data) || data.dueAt == null || data.dueAt is timestamp);
    }

    function isValidCriterion(criteria, index) {
      return criteria.size() <= index
        || (criteria[index] is map
          && criteria[index].keys().hasAll(['id', 'label', 'description', 'maxScore', 'weight'])
          && criteria[index].keys().hasOnly(['id', 'label', 'description', 'maxScore', 'weight'])
          && criteria[index].id is string
          && criteria[index].id.size() > 0
          && criteria[index].id.size() <= 60
          && criteria[index].label is string
          && criteria[index].label.size() > 0
          && criteria[index].label.size() <= 120
          && criteria[index].description is string
          && criteria[index].description.size() <= 1000
          && criteria[index].maxScore is number
          && criteria[index].maxScore > 0
          && criteria[index].maxScore <= 100
          && criteria[index].weight is number
          && criteria[index].weight > 0
          && criteria[index].weight <= 100);
    }

    function validCriterionScore(criteria, scores, index) {
      return criteria.size() <= index
        || (isValidCriterion(criteria, index)
          && criteria[index].id in scores
          && scores[criteria[index].id] is number
          && scores[criteria[index].id] >= 0
          && scores[criteria[index].id] <= criteria[index].maxScore);
    }

    function isValidCriteriaSet(data) {
      return data is map
        && data.keys().hasAll(['name', 'criteria'])
        && data.keys().hasOnly(['name', 'criteria'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.criteria is list
        && data.criteria.size() > 0
        && data.criteria.size() <= 10
        && isValidCriterion(data.criteria, 0)
        && isValidCriterion(data.criteria, 1)
        && isValidCriterion(data.criteria, 2)
        && isValidCriterion(data.criteria, 3)
        && isValidCriterion(data.criteria, 4)
        && isValidCriterion(data.criteria, 5)
        && isValidCriterion(data.criteria, 6)
        && isValidCriterion(data.criteria, 7)
        && isValidCriterion(data.criteria, 8)
        && isValidCriterion(data.criteria, 9);
    }

    function isValidStage(data) {
      return data is map
        && data.keys().hasAll([
          'name', 'order', 'criteriaSetId', 'evaluatorUids', 'requiresAdjudication', 'isActive'
        ])
        && data.keys().hasOnly([
          'name', 'order', 'criteriaSetId', 'evaluatorUids', 'requiresAdjudication', 'isActive'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.order is int && data.order >= 0 && data.order <= 1000
        && data.criteriaSetId is string
        && data.criteriaSetId.size() > 0 && data.criteriaSetId.size() <= 128
        && data.evaluatorUids is list && data.evaluatorUids.size() <= 10
        && (data.evaluatorUids.size() < 1 || (data.evaluatorUids[0] is string && data.evaluatorUids[0].size() > 0 && data.evaluatorUids[0].size() <= 128))
        && (data.evaluatorUids.size() < 2 || (data.evaluatorUids[1] is string && data.evaluatorUids[1].size() > 0 && data.evaluatorUids[1].size() <= 128))
        && (data.evaluatorUids.size() < 3 || (data.evaluatorUids[2] is string && data.evaluatorUids[2].size() > 0 && data.evaluatorUids[2].size() <= 128))
        && (data.evaluatorUids.size() < 4 || (data.evaluatorUids[3] is string && data.evaluatorUids[3].size() > 0 && data.evaluatorUids[3].size() <= 128))
        && (data.evaluatorUids.size() < 5 || (data.evaluatorUids[4] is string && data.evaluatorUids[4].size() > 0 && data.evaluatorUids[4].size() <= 128))
        && (data.evaluatorUids.size() < 6 || (data.evaluatorUids[5] is string && data.evaluatorUids[5].size() > 0 && data.evaluatorUids[5].size() <= 128))
        && (data.evaluatorUids.size() < 7 || (data.evaluatorUids[6] is string && data.evaluatorUids[6].size() > 0 && data.evaluatorUids[6].size() <= 128))
        && (data.evaluatorUids.size() < 8 || (data.evaluatorUids[7] is string && data.evaluatorUids[7].size() > 0 && data.evaluatorUids[7].size() <= 128))
        && (data.evaluatorUids.size() < 9 || (data.evaluatorUids[8] is string && data.evaluatorUids[8].size() > 0 && data.evaluatorUids[8].size() <= 128))
        && (data.evaluatorUids.size() < 10 || (data.evaluatorUids[9] is string && data.evaluatorUids[9].size() > 0 && data.evaluatorUids[9].size() <= 128))
        && data.requiresAdjudication is bool
        && data.isActive is bool;
    }

    function criterionWeight(criteria, index) {
      return criteria.size() > index ? criteria[index].weight : 0;
    }

    function criterionContribution(criteria, scores, index) {
      return criteria.size() > index
        ? criteria[index].weight * scores[criteria[index].id] / criteria[index].maxScore
        : 0;
    }

    function validWeightedTotal(criteria, scores, total) {
      let weights = criterionWeight(criteria, 0) + criterionWeight(criteria, 1)
        + criterionWeight(criteria, 2) + criterionWeight(criteria, 3)
        + criterionWeight(criteria, 4) + criterionWeight(criteria, 5)
        + criterionWeight(criteria, 6) + criterionWeight(criteria, 7)
        + criterionWeight(criteria, 8) + criterionWeight(criteria, 9);
      let earned = criterionContribution(criteria, scores, 0) + criterionContribution(criteria, scores, 1)
        + criterionContribution(criteria, scores, 2) + criterionContribution(criteria, scores, 3)
        + criterionContribution(criteria, scores, 4) + criterionContribution(criteria, scores, 5)
        + criterionContribution(criteria, scores, 6) + criterionContribution(criteria, scores, 7)
        + criterionContribution(criteria, scores, 8) + criterionContribution(criteria, scores, 9);
      return weights > 0
        && total is number
        && total >= 0
        && total <= 100
        && math.abs(total - math.round(earned / weights * 10000) / 100) < 0.001;
    }

    function isValidEvaluationScores(stageId, scores, total) {
      let stagePath = /databases/$(database)/documents/stages/$(stageId);
      let stage = get(stagePath).data;
      let criteriaSetPath = /databases/$(database)/documents/criteriaSets/$(stage.criteriaSetId);
      let criteriaSet = get(criteriaSetPath).data;
      let criteria = criteriaSet.criteria;
      return exists(stagePath)
        && stage.criteriaSetId is string
        && exists(criteriaSetPath)
        && criteriaSet is map
        && criteriaSet.keys().hasAll(['name', 'criteria'])
        && criteriaSet.keys().hasOnly(['name', 'criteria'])
        && criteriaSet.name is string
        && criteriaSet.name.size() > 0
        && criteriaSet.name.size() <= 120
        && criteria is list
        && criteria.size() > 0
        && criteria.size() <= 10
        && scores is map
        && scores.keys().size() == criteria.size()
        && validCriterionScore(criteria, scores, 0)
        && validCriterionScore(criteria, scores, 1)
        && validCriterionScore(criteria, scores, 2)
        && validCriterionScore(criteria, scores, 3)
        && validCriterionScore(criteria, scores, 4)
        && validCriterionScore(criteria, scores, 5)
        && validCriterionScore(criteria, scores, 6)
        && validCriterionScore(criteria, scores, 7)
        && validCriterionScore(criteria, scores, 8)
        && validCriterionScore(criteria, scores, 9)
        && validWeightedTotal(criteria, scores, total);
    }

    function isValidEvaluation(data, evaluationId, ideaId, stageId, evaluatorUid) {
      return data is map
        && data.keys().hasAll([
          'stageId', 'evaluatorUid', 'scores', 'comments', 'recommendation', 'total', 'submittedAt'
        ])
        && data.keys().hasOnly([
          'stageId', 'evaluatorUid', 'scores', 'comments', 'recommendation', 'total', 'submittedAt'
        ])
        && evaluationId == stageId + '_' + evaluatorUid
        && data.stageId == stageId
        && data.evaluatorUid == evaluatorUid
        && data.comments is string
        && data.comments.size() <= 5000
        && data.recommendation in ['advance', 'revise', 'decline']
        && data.submittedAt == request.time
        && isValidEvaluationScores(stageId, data.scores, data.total);
    }

    function hasValidEvaluationAfter(ideaId, stageId, evaluatorUid) {
      let evaluationId = stageId + '_' + evaluatorUid;
      let evaluationPath = /databases/$(database)/documents/ideas/$(ideaId)/evaluations/$(evaluationId);
      return existsAfter(evaluationPath)
        && isValidEvaluation(
          getAfter(evaluationPath).data,
          evaluationId,
          ideaId,
          stageId,
          evaluatorUid
        );
    }

    function isValidEvaluatorView(ideaId, assignmentId) {
      let view = request.resource.data;
      let ideaPath = /databases/$(database)/documents/ideas/$(ideaId);
      let assignmentPath = /databases/$(database)/documents/assignments/$(assignmentId);
      let stagePath = /databases/$(database)/documents/stages/$(view.stageId);
      let idea = get(ideaPath).data;
      let assignment = getAfter(assignmentPath).data;
      let stage = get(stagePath).data;
      let criteriaSetPath = /databases/$(database)/documents/criteriaSets/$(stage.criteriaSetId);
      let criteriaSet = get(criteriaSetPath).data;
      return view.keys().hasAll([
          'ideaId', 'assignmentId', 'evaluatorUid', 'stageId', 'stageName', 'criteriaSetId',
          'criteriaSet', 'title', 'category', 'problem', 'proposedSolution', 'intendedBeneficiaries',
          'plannedLocation', 'marketPlan', 'feasibilityPlan', 'financingPlan', 'milestones',
          'automatedReview', 'createdAt'
        ])
        && view.keys().hasOnly([
          'ideaId', 'assignmentId', 'evaluatorUid', 'stageId', 'stageName', 'criteriaSetId',
          'criteriaSet', 'title', 'category', 'problem', 'proposedSolution', 'intendedBeneficiaries',
          'plannedLocation', 'marketPlan', 'feasibilityPlan', 'financingPlan', 'milestones',
          'automatedReview', 'createdAt'
        ])
        && view.ideaId == ideaId
        && view.assignmentId == assignmentId
        && view.evaluatorUid == assignment.evaluatorUid
        && isExternalEvaluatorAccount(view.evaluatorUid)
        && assignment.ideaId == ideaId
        && assignment.stageId == view.stageId
        && assignment.status == 'pending'
        && view.stageName == stage.name
        && view.criteriaSetId == stage.criteriaSetId
        && view.criteriaSet is map
        && view.criteriaSet.keys().hasAll(['id', 'name', 'criteria'])
        && view.criteriaSet.keys().hasOnly(['id', 'name', 'criteria'])
        && view.criteriaSet.id == stage.criteriaSetId
        && view.criteriaSet.name == criteriaSet.name
        && view.criteriaSet.criteria == criteriaSet.criteria
        && view.title == idea.title
        && view.category == idea.get('category', null)
        && view.problem == idea.problem
        && view.proposedSolution == idea.proposedSolution
        && view.intendedBeneficiaries == idea.intendedBeneficiaries
        && view.plannedLocation == idea.plannedLocation
        && view.marketPlan == idea.marketPlan
        && view.feasibilityPlan == idea.feasibilityPlan
        && view.financingPlan == idea.financingPlan
        && view.milestones == idea.milestones
        && view.automatedReview == idea.automatedReview
        && view.createdAt == request.time;
    }

    function isAgent() {
      return request.auth != null && request.auth.token.role in ['agent', 'admin'];
    }

    function canReadIdea(ownerId) {
      return request.auth != null
        && (request.auth.uid == ownerId || isInternalEvaluator());
    }

    function isBoundedString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isValidCost(cost) {
      return cost is map
        && cost.keys().hasAll(['item', 'amount', 'description'])
        && cost.keys().hasOnly(['item', 'amount', 'description'])
        && isBoundedString(cost.item, 120)
        && cost.item.size() > 0
        && cost.amount is number
        && cost.amount >= 0
        && isBoundedString(cost.description, 1000);
    }

    function isValidCosts(costs) {
      return costs is list
        && costs.size() <= 10
        && (costs.size() < 1 || isValidCost(costs[0]))
        && (costs.size() < 2 || isValidCost(costs[1]))
        && (costs.size() < 3 || isValidCost(costs[2]))
        && (costs.size() < 4 || isValidCost(costs[3]))
        && (costs.size() < 5 || isValidCost(costs[4]))
        && (costs.size() < 6 || isValidCost(costs[5]))
        && (costs.size() < 7 || isValidCost(costs[6]))
        && (costs.size() < 8 || isValidCost(costs[7]))
        && (costs.size() < 9 || isValidCost(costs[8]))
        && (costs.size() < 10 || isValidCost(costs[9]));
    }

    function isValidMilestone(milestone) {
      return milestone is map
        && milestone.keys().hasAll(['title', 'targetDate', 'successMeasure', 'estimatedCost'])
        && milestone.keys().hasOnly(['title', 'targetDate', 'successMeasure', 'estimatedCost'])
        && isBoundedString(milestone.title, 120)
        && milestone.title.size() > 0
        && isBoundedString(milestone.targetDate, 40)
        && isBoundedString(milestone.successMeasure, 1000)
        && (milestone.estimatedCost == null ||
          (milestone.estimatedCost is number && milestone.estimatedCost >= 0));
    }

    function isValidMilestones(milestones) {
      return milestones is list
        && milestones.size() <= 10
        && (milestones.size() < 1 || isValidMilestone(milestones[0]))
        && (milestones.size() < 2 || isValidMilestone(milestones[1]))
        && (milestones.size() < 3 || isValidMilestone(milestones[2]))
        && (milestones.size() < 4 || isValidMilestone(milestones[3]))
        && (milestones.size() < 5 || isValidMilestone(milestones[4]))
        && (milestones.size() < 6 || isValidMilestone(milestones[5]))
        && (milestones.size() < 7 || isValidMilestone(milestones[6]))
        && (milestones.size() < 8 || isValidMilestone(milestones[7]))
        && (milestones.size() < 9 || isValidMilestone(milestones[8]))
        && (milestones.size() < 10 || isValidMilestone(milestones[9]));
    }

    function isValidIdea() {
      return request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 120
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.problem is string
        && request.resource.data.problem.size() <= 5000
        && request.resource.data.proposedSolution is string
        && request.resource.data.proposedSolution.size() <= 5000
        && request.resource.data.intendedBeneficiaries is string
        && request.resource.data.intendedBeneficiaries.size() <= 2000
        && request.resource.data.plannedLocation is string
        && request.resource.data.plannedLocation.size() <= 200
        && request.resource.data.aiAnalysisConsent is bool
        && request.resource.data.status == 'submitted'
        && request.resource.data.version is int
        && request.resource.data.version == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidNewQuestion(ideaId) {
      return request.resource.data.keys().hasAll([
          'askedBy',
          'stageId',
          'question',
          'createdAt',
          'response',
          'respondedBy',
          'respondedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'askedBy',
          'stageId',
          'question',
          'createdAt',
          'response',
          'respondedBy',
          'respondedAt'
        ])
        && request.resource.data.askedBy == request.auth.uid
        && (request.resource.data.stageId == null
          || (request.resource.data.stageId is string
            && (isInternalEvaluator()
              || isAssignedToIdeaStage(ideaId, request.resource.data.stageId, request.auth.uid))))
        && (isInternalEvaluator()
          || (isExternalEvaluator()
            && request.resource.data.stageId is string
            && isAssignedToIdeaStage(ideaId, request.resource.data.stageId, request.auth.uid)))
        && isBoundedString(request.resource.data.question, 2000)
        && request.resource.data.question.size() > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.response == null
        && request.resource.data.respondedBy == null
        && request.resource.data.respondedAt == null;
    }

    function isValidQuestionResponse() {
      return resource.data.response == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'response',
          'respondedBy',
          'respondedAt'
        ])
        && isBoundedString(request.resource.data.response, 5000)
        && request.resource.data.response.size() > 0
        && request.resource.data.respondedBy == request.auth.uid
        && request.resource.data.respondedAt == request.time;
    }

    function isValidFeedbackReply() {
      let reply = request.resource.data.get('reply', null);
      return resource.data.get('reply', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply'])
        && request.resource.data.keys().hasAll([
          'stageId', 'evaluatorUid', 'evaluatorName', 'message',
          'requiresResubmission', 'reply', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'stageId', 'evaluatorUid', 'evaluatorName', 'message',
          'requiresResubmission', 'reply', 'createdAt'
        ])
        && isBoundedString(request.resource.data.stageId, 80)
        && request.resource.data.stageId.size() > 0
        && isBoundedString(request.resource.data.evaluatorUid, 128)
        && request.resource.data.evaluatorUid.size() > 0
        && isBoundedString(request.resource.data.evaluatorName, 120)
        && request.resource.data.evaluatorName.size() > 0
        && isBoundedString(request.resource.data.message, 500)
        && request.resource.data.message.size() > 0
        && request.resource.data.requiresResubmission == true
        && reply is map
        && reply.keys().hasAll(['message', 'at'])
        && reply.keys().hasOnly(['message', 'at'])
        && isBoundedString(reply.message, 2000)
        && reply.message.size() > 0
        && reply.at == request.time
        && request.resource.data.createdAt is timestamp;
    }

    function isValidProfile(profile) {
      return profile is map
        && profile.keys().hasAll([
          'userType',
          'profession',
          'purpose',
          'plannedLocation',
          'goals',
          'address',
          'contacts',
          'passwordLastSetAt',
          'onboardingCompleted',
          'onboardingCompletedAt'
        ])
        && profile.keys().hasOnly([
          'userType',
          'profession',
          'purpose',
          'plannedLocation',
          'goals',
          'address',
          'contacts',
          'passwordLastSetAt',
          'onboardingCompleted',
          'onboardingCompletedAt'
        ])
        && profile.userType in ['individual', 'organization']
        && profile.profession is string && profile.profession.size() <= 200
        && profile.purpose is string && profile.purpose.size() <= 2000
        && profile.plannedLocation is string && profile.plannedLocation.size() <= 200
        && profile.goals is string && profile.goals.size() <= 2000
        && profile.address is map
        && profile.address.keys().hasAll(['plotNumber', 'boxNumber', 'location'])
        && profile.address.keys().hasOnly(['plotNumber', 'boxNumber', 'location'])
        && profile.address.plotNumber is string && profile.address.plotNumber.size() <= 100
        && profile.address.boxNumber is string && profile.address.boxNumber.size() <= 100
        && profile.address.location is string && profile.address.location.size() <= 200
        && profile.contacts is map
        && profile.contacts.keys().hasAll(['phoneNumber'])
        && profile.contacts.keys().hasOnly(['phoneNumber'])
        && profile.contacts.phoneNumber is string && profile.contacts.phoneNumber.size() <= 30
        && (profile.passwordLastSetAt == null || profile.passwordLastSetAt is timestamp)
        && profile.onboardingCompleted is bool
        && (profile.onboardingCompletedAt == null || profile.onboardingCompletedAt is timestamp);
    }

    function isValidNewChat() {
      return request.resource.data.keys().hasAll([
          'userId', 'userName', 'status', 'handledBy', 'handledByName',
          'startedAt', 'closedAt', 'lastMessageAt', 'firstResponseAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'userName', 'status', 'handledBy', 'handledByName',
          'startedAt', 'closedAt', 'lastMessageAt', 'firstResponseAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && isBoundedString(request.resource.data.userName, 120)
        && request.resource.data.status in ['waiting', 'offline_message']
        && request.resource.data.handledBy == null
        && request.resource.data.handledByName == null
        && request.resource.data.startedAt == request.time
        && request.resource.data.closedAt == null
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.firstResponseAt == null;
    }

    function isValidOwnerChatUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.status in ['waiting', 'active', 'offline_message']
        && ((changedKeys.hasOnly(['lastMessageAt'])
              && request.resource.data.lastMessageAt == request.time)
            || (changedKeys.hasOnly(['status', 'closedAt'])
              && request.resource.data.status == 'closed'
              && request.resource.data.closedAt == request.time));
    }

    function isValidAgentChatClaim() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.handledBy == null
        && resource.data.status == 'waiting'
        && changedKeys.hasOnly(['handledBy', 'handledByName', 'status'])
        && request.resource.data.handledBy == request.auth.uid
        && isBoundedString(request.resource.data.handledByName, 120)
        && request.resource.data.status == 'active';
    }

    function isValidAgentChatUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.handledBy == request.auth.uid
        && changedKeys.hasOnly(['lastMessageAt', 'firstResponseAt', 'status', 'closedAt'])
        && (request.resource.data.lastMessageAt == resource.data.lastMessageAt
            || request.resource.data.lastMessageAt == request.time)
        && (request.resource.data.firstResponseAt == resource.data.firstResponseAt
            || request.resource.data.firstResponseAt == request.time)
        && request.resource.data.status in ['active', 'closed']
        && (request.resource.data.status != 'closed' || request.resource.data.closedAt == request.time);
    }

    function isValidNewChatMessage(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return request.resource.data.keys().hasAll(['senderUid', 'senderRole', 'text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['senderUid', 'senderRole', 'text', 'createdAt'])
        && request.resource.data.senderUid == request.auth.uid
        && isBoundedString(request.resource.data.senderRole, 30)
        && isBoundedString(request.resource.data.text, 4000)
        && request.resource.data.text.size() > 0
        && request.resource.data.createdAt == request.time
        && chat.status != 'closed'
        && (signedInAs(chat.userId) || (isAgent() && chat.handledBy == request.auth.uid));
    }

    function isValidAgentPresence(uid) {
      return request.resource.data.keys().hasAll([
          'uid', 'displayName', 'isAvailable', 'activeChatCount', 'maxConcurrentChats', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'isAvailable', 'activeChatCount', 'maxConcurrentChats', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && isBoundedString(request.resource.data.displayName, 120)
        && request.resource.data.isAvailable is bool
        && request.resource.data.activeChatCount is int
        && request.resource.data.activeChatCount >= 0
        && request.resource.data.maxConcurrentChats is int
        && request.resource.data.maxConcurrentChats > 0
        && request.resource.data.maxConcurrentChats <= 20
        && request.resource.data.updatedAt == request.time;
    }

    function isValidChatSettings() {
      return request.resource.data.keys().hasAll(['timezone', 'days', 'open', 'close', 'holidays'])
        && request.resource.data.keys().hasOnly(['timezone', 'days', 'open', 'close', 'holidays'])
        && isBoundedString(request.resource.data.timezone, 60)
        && request.resource.data.days is list
        && request.resource.data.days.size() <= 7
        && isBoundedString(request.resource.data.open, 5)
        && isBoundedString(request.resource.data.close, 5)
        && request.resource.data.holidays is list
        && request.resource.data.holidays.size() <= 60;
    }

    function isValidUser(userId) {
      return request.resource.data.keys().hasAll([
          'uid',
          'email',
          'fullName',
          'emailVerified',
          'phoneNumberVerified',
          'role',
          'evaluatorType',
          'organization',
          'profile',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'fullName',
          'emailVerified',
          'phoneNumberVerified',
          'role',
          'evaluatorType',
          'organization',
          'profile',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.emailVerified is bool
        && request.resource.data.phoneNumberVerified is bool
        && request.resource.data.role in ['user', 'submitter']
        && request.resource.data.evaluatorType == null
        && request.resource.data.organization == null
        && isValidProfile(request.resource.data.profile)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isNullableTimestamp(value) {
      return value == null || value is timestamp;
    }

    function isValidNewsletterPreferences(data) {
      return data.keys().hasAll([
          'newsletter',
          'promotions',
          'newsletterConsentedAt',
          'promotionsConsentedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'newsletter',
          'promotions',
          'newsletterConsentedAt',
          'promotionsConsentedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.newsletter is bool
        && data.promotions is bool
        && isNullableTimestamp(data.newsletterConsentedAt)
        && isNullableTimestamp(data.promotionsConsentedAt)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidNewsletterConsentOnCreate(data) {
      return (data.newsletter
          ? data.newsletterConsentedAt == request.time
          : data.newsletterConsentedAt == null)
        && (data.promotions
          ? data.promotionsConsentedAt == request.time
          : data.promotionsConsentedAt == null);
    }

    function hasValidNewsletterConsentOnUpdate(data) {
      return (data.newsletterConsentedAt == resource.data.newsletterConsentedAt
          || (!resource.data.newsletter
            && data.newsletter
            && data.newsletterConsentedAt == request.time))
        && (data.promotionsConsentedAt == resource.data.promotionsConsentedAt
          || (!resource.data.promotions
            && data.promotions
            && data.promotionsConsentedAt == request.time));
    }

    function isValidCollaborationUid(uid) {
      return uid is string
        && uid.size() > 0
        && uid.size() <= 128
        && uid.matches('^[A-Za-z0-9_-]+$');
    }

    function isCollaborationUser(uid) {
      return isValidCollaborationUid(uid)
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role in ['user', 'submitter'];
    }

    function hasDiscoverableProfile(uid) {
      return exists(/databases/$(database)/documents/collaborationProfiles/$(uid))
        && get(/databases/$(database)/documents/collaborationProfiles/$(uid)).data.uid == uid
        && get(/databases/$(database)/documents/collaborationProfiles/$(uid)).data.discoverable == true;
    }

    function isValidCollaborationProfileData(data, uid) {
      return isCollaborationUser(uid)
        && data.keys().hasAll([
          'uid',
          'displayName',
          'profession',
          'displayNameSearch',
          'professionSearch',
          'discoverable',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'profession',
          'displayNameSearch',
          'professionSearch',
          'discoverable',
          'createdAt',
          'updatedAt'
        ])
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 120
        && data.profession is string
        && data.profession.size() > 0
        && data.profession.size() <= 200
        && data.displayNameSearch is string
        && data.displayNameSearch.size() > 0
        && data.displayNameSearch.size() <= 120
        && data.displayNameSearch == data.displayName.trim().lower()
        && data.professionSearch is string
        && data.professionSearch.size() > 0
        && data.professionSearch.size() <= 200
        && data.professionSearch == data.profession.trim().lower()
        && data.displayName == get(/databases/$(database)/documents/users/$(uid)).data.fullName
        && data.profession == get(/databases/$(database)/documents/users/$(uid)).data.profile.profession
        && data.discoverable == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCollaborationPair(data, pairId) {
      return data.keys().hasAll([
          'participants',
          'senderUid',
          'recipientUid',
          'status',
          'createdAt',
          'updatedAt',
          'respondedAt'
        ])
        && data.keys().hasOnly([
          'participants',
          'senderUid',
          'recipientUid',
          'status',
          'createdAt',
          'updatedAt',
          'respondedAt'
        ])
        && data.participants is list
        && data.participants.size() == 2
        && isValidCollaborationUid(data.participants[0])
        && isValidCollaborationUid(data.participants[1])
        && data.participants[0] < data.participants[1]
        && pairId == data.participants[0] + '~' + data.participants[1]
        && data.senderUid is string
        && data.recipientUid is string
        && data.senderUid != data.recipientUid
        && data.senderUid in data.participants
        && data.recipientUid in data.participants
        && data.status in ['pending', 'accepted', 'declined', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.respondedAt == null || data.respondedAt is timestamp);
    }

    function hasSameCollaborationParticipants() {
      return request.resource.data.participants == resource.data.participants
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.recipientUid == resource.data.recipientUid;
    }

    function isValidCollaborationResponse(pairId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isValidCollaborationPair(request.resource.data, pairId)
        && hasSameCollaborationParticipants()
        && resource.data.status == 'pending'
        && request.auth.uid == resource.data.recipientUid
        && request.resource.data.status in ['accepted', 'declined']
        && changedKeys.hasOnly(['status', 'updatedAt', 'respondedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.respondedAt == request.time;
    }

    function isValidCollaborationCancellation(pairId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isValidCollaborationPair(request.resource.data, pairId)
        && hasSameCollaborationParticipants()
        && resource.data.status == 'pending'
        && request.auth.uid == resource.data.senderUid
        && request.resource.data.status == 'cancelled'
        && changedKeys.hasOnly(['status', 'updatedAt', 'respondedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.respondedAt == request.time;
    }

    function isValidCollaborationResend(pairId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isValidCollaborationPair(request.resource.data, pairId)
        && request.resource.data.participants == resource.data.participants
        && resource.data.status in ['declined', 'cancelled']
        && request.auth.uid == request.resource.data.senderUid
        && request.resource.data.status == 'pending'
        && changedKeys.hasOnly([
          'senderUid',
          'recipientUid',
          'status',
          'createdAt',
          'updatedAt',
          'respondedAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.respondedAt == null
        && isCollaborationUser(request.resource.data.senderUid)
        && isCollaborationUser(request.resource.data.recipientUid)
        && hasDiscoverableProfile(request.resource.data.senderUid)
        && hasDiscoverableProfile(request.resource.data.recipientUid);
    }

    match /users/{userId} {
      allow get: if signedInAs(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if signedInAs(userId)
        && isValidUser(userId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.phoneNumberVerified == false
        && request.resource.data.role in ['user', 'submitter']
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedInAs(userId)
        && isValidUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'profile',
          'updatedAt'
        ])
        && request.resource.data.profile.passwordLastSetAt ==
          resource.data.profile.passwordLastSetAt
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.fullName == resource.data.fullName
        && request.resource.data.emailVerified == resource.data.emailVerified
        && request.resource.data.phoneNumberVerified == resource.data.phoneNumberVerified
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /users/{userId}/newsletterPreferences/{preferencesId} {
      allow get: if preferencesId == 'current'
        && signedInAs(userId)
        && isUser();
      allow list: if false;
      allow create: if preferencesId == 'current'
        && signedInAs(userId)
        && isUser()
        && isValidNewsletterPreferences(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && hasValidNewsletterConsentOnCreate(request.resource.data);
      allow update: if preferencesId == 'current'
        && signedInAs(userId)
        && isUser()
        && isValidNewsletterPreferences(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && hasValidNewsletterConsentOnUpdate(request.resource.data);
      allow delete: if false;
    }

    match /collaborationProfiles/{userId} {
      allow get: if signedInAs(userId)
        || (isUser() && resource.data.discoverable == true);
      allow list: if isUser() && resource.data.discoverable == true;
      allow create: if signedInAs(userId)
        && isValidCollaborationProfileData(request.resource.data, userId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedInAs(userId)
        && isValidCollaborationProfileData(request.resource.data, userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'profession',
          'displayNameSearch',
          'professionSearch',
          'updatedAt'
        ])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedInAs(userId)
        && resource.data.uid == userId
        && resource.data.discoverable == true;
    }

    match /collaborationPairs/{pairId} {
      allow get, list: if isUser() && request.auth.uid in resource.data.participants;
      allow create: if isUser()
        && isValidCollaborationPair(request.resource.data, pairId)
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.respondedAt == null
        && isCollaborationUser(request.resource.data.recipientUid)
        && hasDiscoverableProfile(request.resource.data.senderUid)
        && hasDiscoverableProfile(request.resource.data.recipientUid);
      allow update: if isUser()
        && (isValidCollaborationResponse(pairId)
          || isValidCollaborationCancellation(pairId)
          || isValidCollaborationResend(pairId));
      allow delete: if false;
    }

    match /ideas/{ideaId} {
      function parentIdeaExists() {
        return exists(/databases/$(database)/documents/ideas/$(ideaId));
      }

      function parentIdeaOwnerId() {
        return get(/databases/$(database)/documents/ideas/$(ideaId)).data.ownerId;
      }

      allow create: if isUser()
        && isValidIdea()
        && request.resource.data.keys().hasAll([
          'ownerId',
          'ownerName',
          'title',
          'problem',
          'proposedSolution',
          'intendedBeneficiaries',
          'plannedLocation',
          'marketPlan',
          'feasibilityPlan',
          'financingPlan',
          'milestones',
          'aiAnalysisConsent',
          'aiAnalysisConsentAt',
          'automatedReview',
          'status',
          'version',
          'createdAt',
          'submittedAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerId',
          'ownerName',
          'title',
          'problem',
          'proposedSolution',
          'intendedBeneficiaries',
          'plannedLocation',
          'marketPlan',
          'feasibilityPlan',
          'financingPlan',
          'milestones',
          'aiAnalysisConsent',
          'aiAnalysisConsentAt',
          'automatedReview',
          'status',
          'version',
          'createdAt',
          'submittedAt',
          'updatedAt'
        ])
        && request.resource.data.aiAnalysisConsent == true
        && request.resource.data.aiAnalysisConsentAt == request.time
        && request.resource.data.marketPlan is map
        && request.resource.data.marketPlan.keys().hasAll([
          'targetMarket',
          'alternatives',
          'differentiation',
          'marketValidation'
        ])
        && request.resource.data.marketPlan.keys().hasOnly([
          'targetMarket',
          'alternatives',
          'differentiation',
          'marketValidation'
        ])
        && isBoundedString(request.resource.data.marketPlan.targetMarket, 3000)
        && isBoundedString(request.resource.data.marketPlan.alternatives, 3000)
        && isBoundedString(request.resource.data.marketPlan.differentiation, 3000)
        && isBoundedString(request.resource.data.marketPlan.marketValidation, 3000)
        && request.resource.data.feasibilityPlan is map
        && request.resource.data.feasibilityPlan.keys().hasAll([
          'technicalApproach',
          'operationalPlan',
          'validationEvidence',
          'assumptions',
          'risks'
        ])
        && request.resource.data.feasibilityPlan.keys().hasOnly([
          'technicalApproach',
          'operationalPlan',
          'validationEvidence',
          'assumptions',
          'risks'
        ])
        && isBoundedString(request.resource.data.feasibilityPlan.technicalApproach, 3000)
        && isBoundedString(request.resource.data.feasibilityPlan.operationalPlan, 3000)
        && isBoundedString(request.resource.data.feasibilityPlan.validationEvidence, 3000)
        && isBoundedString(request.resource.data.feasibilityPlan.assumptions, 3000)
        && isBoundedString(request.resource.data.feasibilityPlan.risks, 3000)
        && request.resource.data.financingPlan is map
        && request.resource.data.financingPlan.keys().hasAll([
          'currency',
          'totalFundingNeeded',
          'fundingSources',
          'costs'
        ])
        && request.resource.data.financingPlan.keys().hasOnly([
          'currency',
          'totalFundingNeeded',
          'fundingSources',
          'costs'
        ])
        && isBoundedString(request.resource.data.financingPlan.currency, 10)
        && isBoundedString(request.resource.data.financingPlan.fundingSources, 3000)
        && request.resource.data.financingPlan.totalFundingNeeded is number
        && request.resource.data.financingPlan.totalFundingNeeded > 0
        && isValidCosts(request.resource.data.financingPlan.costs)
        && request.resource.data.financingPlan.costs.size() > 0
        && isValidMilestones(request.resource.data.milestones)
        && request.resource.data.milestones.size() > 0
        && request.resource.data.automatedReview is map
        && request.resource.data.automatedReview.keys().hasAll([
          'status',
          'model',
          'rubricVersion',
          'summary',
          'criteria',
          'strengths',
          'informationGaps',
          'questionsForHumanEvaluator',
          'limitations',
          'startedAt',
          'completedAt',
          'failureMessage'
        ])
        && request.resource.data.automatedReview.keys().hasOnly([
          'status',
          'model',
          'rubricVersion',
          'summary',
          'criteria',
          'strengths',
          'informationGaps',
          'questionsForHumanEvaluator',
          'limitations',
          'startedAt',
          'completedAt',
          'failureMessage'
        ])
        && request.resource.data.automatedReview.status == 'queued'
        && request.resource.data.automatedReview.model == 'gemini-3.5-flash-lite'
        && request.resource.data.automatedReview.rubricVersion == 'cedability-v1'
        && request.resource.data.automatedReview.summary == ''
        && request.resource.data.automatedReview.criteria == null
        && request.resource.data.automatedReview.strengths == []
        && request.resource.data.automatedReview.informationGaps == []
        && request.resource.data.automatedReview.questionsForHumanEvaluator == []
        && request.resource.data.automatedReview.limitations == []
        && request.resource.data.automatedReview.startedAt == null
        && request.resource.data.automatedReview.completedAt == null
        && request.resource.data.automatedReview.failureMessage == null
        && request.resource.data.version == 1
        && request.resource.data.submittedAt == request.time;
      allow get, list: if canReadIdea(resource.data.ownerId);
      allow update, delete: if false;

      match /versions/{versionId} {
        allow get, list: if parentIdeaExists()
          && isUser()
          && signedInAs(parentIdeaOwnerId());
        allow create, update, delete: if false;
      }

      match /feedback/{feedbackId} {
        allow get, list: if parentIdeaExists()
          && isUser()
          && signedInAs(parentIdeaOwnerId());
        allow create, delete: if false;
        allow update: if parentIdeaExists()
          && isUser()
          && signedInAs(parentIdeaOwnerId())
          && isValidFeedbackReply();
      }

      match /evaluatorViews/{assignmentId} {
        allow get: if isAdmin()
          || (isExternalEvaluator()
            && isAssignmentForIdea(assignmentId, ideaId, request.auth.uid));
        allow list: if false;
        allow create: if isAdmin() && isValidEvaluatorView(ideaId, assignmentId);
        allow update: if false;
        allow delete: if isAdmin()
          && !existsAfter(/databases/$(database)/documents/assignments/$(assignmentId));
      }

      match /evaluations/{evaluationId} {
        allow get: if isAdmin()
          || (request.auth != null && request.auth.token.role == 'adjudicator')
          || (isInternalEvaluator()
            && isAssignedToIdeaStage(ideaId, resource.data.stageId, request.auth.uid))
          || (isExternalEvaluator()
            && resource.data.evaluatorUid == request.auth.uid
            && isAssignedToIdeaStage(ideaId, resource.data.stageId, request.auth.uid));
        allow list: if isAdmin()
          || (request.auth != null && request.auth.token.role == 'adjudicator')
          || (isInternalEvaluator()
            && isAssignedToIdeaStage(ideaId, resource.data.stageId, request.auth.uid));
        allow create: if isEvaluator()
          && request.resource.data.evaluatorUid == request.auth.uid
          && isAssignmentOpen(ideaId, request.resource.data.stageId, request.auth.uid)
          && isValidEvaluation(
            request.resource.data,
            evaluationId,
            ideaId,
            request.resource.data.stageId,
            request.auth.uid
          );
        allow update, delete: if false;
      }

      match /adjudications/{stageId} {
        allow get, list: if isAdjudicatorOrAdmin();
        allow create, update, delete: if false;
      }

      match /questions/{questionId} {
        allow get: if signedInAs(parentIdeaOwnerId())
          || isInternalEvaluator()
          || (isExternalEvaluator()
            && resource.data.stageId is string
            && isAssignedToIdeaStage(ideaId, resource.data.stageId, request.auth.uid));
        allow list: if signedInAs(parentIdeaOwnerId())
          || isInternalEvaluator()
          || (isExternalEvaluator()
            && resource.data.stageId is string
            && isAssignedToIdeaStage(ideaId, resource.data.stageId, request.auth.uid));
        allow create: if parentIdeaExists()
          && isEvaluator()
          && isValidNewQuestion(ideaId);
        allow update: if signedInAs(parentIdeaOwnerId())
          && isUser()
          && isValidQuestionResponse();
        allow delete: if false;
      }
    }

    match /assignments/{assignmentId} {
      allow get: if isAdmin()
        || (isEvaluator() && resource.data.evaluatorUid == request.auth.uid);
      allow list: if isAdmin()
        || (isEvaluator() && resource.data.evaluatorUid == request.auth.uid);
      allow create: if isAdmin()
        && isValidAssignment(request.resource.data, assignmentId)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/ideas/$(request.resource.data.ideaId))
        && exists(/databases/$(database)/documents/stages/$(request.resource.data.stageId))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.evaluatorUid))
        && get(/databases/$(database)/documents/users/$(request.resource.data.evaluatorUid)).data.role == 'evaluator';
      allow update: if isEvaluator()
        && isValidAssignment(request.resource.data, assignmentId)
        && resource.data.evaluatorUid == request.auth.uid
        && resource.data.status in ['pending', 'in_progress']
        && request.resource.data.status == 'done'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.ideaId == resource.data.ideaId
        && request.resource.data.stageId == resource.data.stageId
        && request.resource.data.evaluatorUid == resource.data.evaluatorUid
        && request.resource.data.assignedBy == resource.data.assignedBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.dueAt == resource.data.get('dueAt', null)
        && request.resource.data.updatedAt == request.time
        && hasValidEvaluationAfter(resource.data.ideaId, resource.data.stageId, request.auth.uid);
      allow delete: if isAdmin();
    }

    match /stages/{stageId} {
      allow get, list: if isAdmin() || isInternalEvaluator();
      allow create: if isAdmin() && isValidStage(request.resource.data);
      allow update: if isAdmin()
        && isValidStage(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'order', 'criteriaSetId', 'evaluatorUids', 'requiresAdjudication', 'isActive'
        ]);
      allow delete: if isAdmin();
    }

    match /criteriaSets/{criteriaSetId} {
      allow get, list: if isAdmin() || isInternalEvaluator();
      allow create: if isAdmin() && isValidCriteriaSet(request.resource.data);
      allow update: if isAdmin()
        && isValidCriteriaSet(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'criteria']);
      allow delete: if isAdmin();
    }

    match /stats/{docId} {
      allow get, list: if isAdmin()
        || (request.auth != null && request.auth.token.role == 'adjudicator');
      allow create, update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /awards/{awardId} {
      allow get, list: if isAdmin()
        || (request.auth != null && resource.data.ownerId == request.auth.uid)
        || resource.data.isPublic == true;
      allow create, update, delete: if false;
    }

    match /chats/{chatId} {
      allow get, list: if signedInAs(resource.data.userId) || isAgent();
      allow create: if isValidNewChat();
      allow update: if (isAgent() && (isValidAgentChatClaim() || isValidAgentChatUpdate()))
        || (signedInAs(resource.data.userId) && isValidOwnerChatUpdate());
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if signedInAs(get(/databases/$(database)/documents/chats/$(chatId)).data.userId)
          || isAgent();
        allow create: if isValidNewChatMessage(chatId);
        allow update, delete: if false;
      }
    }

    match /agentPresence/{uid} {
      allow get, list: if request.auth != null;
      allow create, update: if (signedInAs(uid)
            && request.auth.token.role == 'agent'
            && isValidAgentPresence(uid))
          || (isAdmin() && isValidAgentPresence(uid));
      allow delete: if false;
    }

    match /settings/{documentId} {
      allow get: if documentId == 'chat' && request.auth != null;
      allow list: if false;
      allow create, update: if documentId == 'chat' && isAdmin() && isValidChatSettings();
      allow delete: if documentId == 'chat' && isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
